{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IntegrationDb": "Data Source=employee-integration.db"
  },
  "Bus": {
    "MaxDeliveryCount": 3,
    "RedeliveryDelay": "00:00:05"
  },
  "Employee360": {
    "BaseUrl": "http://localhost:5200/",
    "Resilience": {
      "Retry": {
        "MaxRetryAttempts": 3,
        "Delay": "00:00:01",
        "BackoffType": "Exponential",
        "UseJitter": true
      },
      "AttemptTimeout": {
        "Timeout": "00:00:03"
      },
      "TotalRequestTimeout": {
        "Timeout": "00:00:30"
      }
    }
  },
  "ReferenceData": {
    "Locations": {
      "Cape Town": [ "CPT", "CapeTown", "Kaapstad" ],
      "Johannesburg": [ "JHB", "Joburg", "Jozi" ],
      "Durban": [ "DBN", "eThekwini" ],
      "Pretoria": [ "PTA", "Tshwane" ]
    }
  }
}
